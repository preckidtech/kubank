// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- USER TABLE ---
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  avatarUrl String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  Account[]
}

// --- ACCOUNT TABLE ---
model Account {
  id            String   @id @default(cuid())
  accountNumber String   @unique
  balance       Float    @default(50000.00)
  pin           String
  
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt // Added for good practice (Net-Centric Data Consistency)

  // Relations for transaction tracking
  sentTransactions     Transaction[] @relation("SenderAccount")
  receivedTransactions Transaction[] @relation("ReceiverAccount")
}

// --- TRANSACTION TABLE ---
model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  type        String   // e.g., "TRANSFER" or "DEPOSIT"
  status      String   @default("COMPLETED")
  
  // 👇 THIS IS THE FIELD THAT FIXES YOUR ERROR
  description String?  

  senderId    String
  sender      Account  @relation("SenderAccount", fields: [senderId], references: [id])
  
  receiverId  String
  receiver    Account  @relation("ReceiverAccount", fields: [receiverId], references: [id])
  
  createdAt   DateTime @default(now())
}